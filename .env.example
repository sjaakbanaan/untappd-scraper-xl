# Paste your Untappd cookie string here, or run:
#   npm run cookie
UNTAPPD_COOKIE="your_cookie_string_here"

# The Untappd username to scrape
UNTAPPD_USER="username"

# (Optional) Mapbox Access Token for geocoding / location enrichment
# Get one for free at https://account.mapbox.com/
MAPBOX_KEY=""
